# Set credentials locally; never commit .env or paste keys into the UI.
LLM_API_KEY=
# Choose a provider whose CURRENT documentation explicitly serves DeepSeek-V4-Flash.
# api.deepseek.com legacy deepseek-v4-flash now routes to V4.1 and is blocked.
LLM_BASE_URL=
LLM_MODEL=
# Leave blank to use the selected YAML's checked model mapping.
LLM_MODEL_VERIFIED=
LLM_MODEL_VERIFICATION_NOTE=
HF_HOME=.cache/huggingface
TOKENIZERS_PARALLELISM=false
